FLASK_APP=app.py
# Local development only. Disable debugging in production.
FLASK_DEBUG=1

APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret

# Local development settings.
# Render production: SESSION_COOKIE_SECURE=true
# Render production: SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
DATABASE_URL=sqlite:///jb_stickers.db

# Rate-limit storage
# Development uses in-memory storage.
# Production should use a managed Redis URL.
RATELIMIT_STORAGE_URI=memory://

FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend email service
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=your-verified-sender-domain@example.com
